# Zugang und Beispiel-Datensaetze fuer den Screenshot-Lauf — Kopie als .env (gitignored).

KLICK_BASE=
# Zugang MIT Vertrags-Rechten (Buero) — die Serie zeigt Buero-Arbeit.
KLICK_USER=
KLICK_PW=

# Vertrag fuer die Dokumente 2 und 3: am besten ein RATENZAHLER mit SEPA-Mandat,
# einigen bezahlten und einigen offenen Raten. ID aus der URL /hub/contracts/<ID>.
KLICK_CONTRACT=

# Offener Widerruf fuer Dokument 4. ID aus der URL /hub/cancellations/<ID>.
# Ohne diesen Wert fehlen die beiden Bilder der Fallseite.
KLICK_CANCELLATION=

# Suchbegriff fuer die Trefferzeile in Dokument 1 (Nachname der Beispielkundin).
KLICK_SEARCH=
