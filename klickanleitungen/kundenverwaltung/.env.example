# Zugang und Kundin fuer den Screenshot-Lauf — Kopie als .env anlegen (gitignored),
# Werte NIE committen. Das Wiki-Repo ist oeffentlich.

# Umgebung. Staging ueber die *.run.app-Adresse (umgeht IAP):
#   gcloud run services describe glattthub-web-staging --region=europe-west3 --format='value(status.url)'
# Lokal geht auch: KLICK_BASE=http://glattthub.local:8888
KLICK_BASE=

# Anmeldung. Fuer die Aufnahme moeglichst der Rolle entsprechen, die die Anleitung bekommt
# (Institute MA) — nur dann zeigen die Bilder genau das, was die Mitarbeiterin spaeter sieht.
KLICK_USER=
KLICK_PW=

# Die aufgenommene Kundin: Phorest-Client-ID aus der URL /hub/clients/<ID>.
# Es wird eine ECHTE Kundin aufgenommen (Entscheidung Jan 15.09.2026) — sie sollte
# moeglichst viel gefuellt haben: Vertrag, SEPA-Mandat, Termine, Pakete, Formulare,
# WhatsApp-Verlauf, moeglichst auch einen Forderungsfall und ein Zendesk-Ticket.
KLICK_CLIENT=

# Suchbegriff fuer die Trefferliste in Dokument I (in der Regel der Nachname).
KLICK_SEARCH=

# Vertrag fuer die Ausnahmeseite in Dokument L (Zahlungsstand im Vertragsdetail):
# ID aus der URL /hub/contracts/<ID>. Leer lassen = Seite bleibt Platzhalter.
KLICK_CONTRACT=
