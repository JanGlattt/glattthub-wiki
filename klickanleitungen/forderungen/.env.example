# Zugang fuer den Screenshot-Lauf — Kopie als .env anlegen (gitignored).
# Zugang MIT den Rechten des Bueros — die Serie zeigt Bueroarbeit.
# https://staging.hub.glattt.com oder https://hub.glattt.com — IAP passiert der Lauf per Dienstkonto-Token (README, Abschnitt Zugang)
KLICK_BASE=
# Client-ID des eigenen IAP-OAuth-Clients (Audience des Dienstkonto-Tokens); Standard steht in shared/lib/iap.cjs
KLICK_IAP_AUDIENCE=99200336070-1n78g13leh01h24nqoh6ar8lcm01em63.apps.googleusercontent.com
KLICK_USER=
KLICK_PW=

# Aktiver Forderungsfall — ID aus /hub/receivables/<ID>
KLICK_CASE=

# Optional: Fall mit laufender Ratenzahlungsvereinbarung
KLICK_CASE_RZV=

# Optional: Fall im gerichtlichen Mahnverfahren
KLICK_CASE_JUDICIAL=
