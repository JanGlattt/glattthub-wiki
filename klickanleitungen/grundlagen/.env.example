# Zugang fuer den Screenshot-Lauf — Kopie als .env anlegen (gitignored), Werte NIE committen.

# Umgebung. Staging ueber die *.run.app-Adresse (umgeht IAP):
#   gcloud run services describe glattthub-web-staging --region=europe-west3 --format='value(status.url)'
# https://staging.hub.glattt.com oder https://hub.glattt.com — IAP passiert der Lauf per Dienstkonto-Token (README, Abschnitt Zugang)
KLICK_BASE=
# Client-ID des eigenen IAP-OAuth-Clients (Audience des Dienstkonto-Tokens); Standard steht in shared/lib/iap.cjs
KLICK_IAP_AUDIENCE=99200336070-1n78g13leh01h24nqoh6ar8lcm01em63.apps.googleusercontent.com

# Anmeldung. Fuer diese Serie einen Zugang OHNE Sonderrechte nehmen (Rolle Institute MA) —
# die Bilder sollen zeigen, was eine Mitarbeiterin sieht, nicht was Admins sehen.
KLICK_USER=
KLICK_PW=

# Suchbegriff fuer die Trefferliste in Dokument 2 (etwas Unverfaengliches, kein Kundenname).
KLICK_SEARCH=Verträge

# Beispielfrage an glatttBert in Dokument 5. Bewusst eine Zahlen-Frage —
# so landen keine Kundendaten im Screenshot.
KLICK_BERT_FRAGE='Wie viele Beratungsgespräche hatten wir letzte Woche?'
