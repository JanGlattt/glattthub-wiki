# Zugang fuer den Screenshot-Lauf — Kopie als .env anlegen (gitignored), Werte NIE committen.
# Das Wiki-Repo ist oeffentlich: Passwoerter gehoeren ausschliesslich hierher, nicht in die Skripte.

# Umgebung: https://staging.hub.glattt.com oder https://hub.glattt.com. Beide liegen hinter Google IAP;
# der Lauf passiert es mit einem Dienstkonto-Token (shared/lib/iap.cjs) — dafuer einmal `gcloud auth login`
# und die Rolle Service Account Token Creator auf klickanleitungen@glattthub.iam.gserviceaccount.com.
# Der fruehere Umweg ueber die *.run.app-Adresse ist seit 23.09.2026 geschlossen.
KLICK_BASE=https://staging.hub.glattt.com
# Client-ID des eigenen IAP-OAuth-Clients (Audience des Dienstkonto-Tokens); Standard steht in shared/lib/iap.cjs
KLICK_IAP_AUDIENCE=99200336070-1n78g13leh01h24nqoh6ar8lcm01em63.apps.googleusercontent.com

# Testuser auf Staging (Rolle Institute MA, Magdeburg) — Passwort vor dem Lauf frisch setzen
KLICK_USER=claude-dev@example.com
KLICK_PW=

# Phorest-Branch-ID Magdeburg (Standard, nur bei anderem Institut aendern)
KLICK_BRANCH=KrzIg1nVrQ3kpKzkTgQlzA

# Der fuer diesen Lauf gebuchte Beratungstermin: Phorest-Termin-ID aus der URL
# /hub/appointment/<branch>/<APT> und sein Tag (JJJJ-MM-TT).
# Der Termin muss einer Magdeburg-Testkundin (MD000001-MD000004) gehoeren, Status „Gebucht",
# und als einziger Termin dieser Kundin an dem Tag stehen (Phorest fasst Tagestermine sonst
# zu einer Sammelkarte zusammen).
KLICK_APT=
KLICK_DATE=

# Dokument 9 „Termin buchen": Kundennummer fuer das Beispiel (Magdeburg-Testkundin).
KLICK_BOOK_CLIENT=MD000002
# Nur auf 1 setzen, wenn wirklich gebucht werden soll — der Termin landet im ECHTEN
# Phorest-Kalender und muss danach von Hand storniert werden. Standard: nicht buchen.
KLICK_BOOK=

# Dokument 10 „Sitzungsbestätigung“: Phorest-ID eines gebuchten BEHANDLUNGStermins der Testkundin
# (Magdeburg, Paket-Services). Der Lauf startet den Termin und reicht das Pflichtformular ein.
KLICK_TREAT=

# Dokument 11 „Erlaubnis Minderjährige“: gebuchter Termin (beliebige Dienstleistung) einer Magdeburg-
# Testkundin, die in Phorest noch KEIN Geburtsdatum hat, ihre Phorest-Client-ID, das Geburtsdatum,
# das der Lauf ihr einträgt (Kundin wird 16), und die E-Mail-Adresse des zweiten Elternteils
# (Staging verschickt die Mail wirklich — eine eigene Test-Adresse nehmen).
KLICK_MINOR_APT=
KLICK_MINOR_CLIENT=
KLICK_MINOR_DOB=2010-05-14
KLICK_PARENT_MAIL=
# Link der zweiten Person für flow10b.cjs (aus der Mail bzw. form_share_tokens auf Staging)
KLICK_COSIGN_URL=
